#!/usr/bin/env bash

set -o nounset
set -o pipefail

modern_bash_bin_dir=$(
    CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P
) || exit 1
modern_bash_root_dir=$(CDPATH='' cd -- "${modern_bash_bin_dir}/.." && pwd -P) || exit 1

# shellcheck source=src/modern-bash.bash
source "${modern_bash_root_dir}/src/modern-bash.bash"
# shellcheck source=src/commands/doctor.bash
source "${modern_bash_root_dir}/src/commands/doctor.bash"

modern_bash::cli::usage() {
    cat <<'USAGE'
Usage: modern-bash <command> [options]

Commands:
  doctor    Inspect the shell and terminal environment
  help      Show this help

Options:
  -h, --help       Show this help
  -V, --version    Show the Modern Bash version
USAGE
}

modern_bash::cli::main() {
    local command_name=${1:-help}

    if (($# > 0)); then
        shift
    fi

    case ${command_name} in
        doctor)
            modern_bash::doctor::run "$@"
            ;;
        help|-h|--help)
            modern_bash::cli::usage
            ;;
        -V|--version)
            printf 'modern-bash %s\n' "${MODERN_BASH_VERSION}"
            ;;
        *)
            printf 'modern-bash: unknown command: %s\n' "${command_name}" >&2
            printf "Run 'modern-bash --help' for usage.\n" >&2
            return 64
            ;;
    esac
}

modern_bash::cli::main "$@"
